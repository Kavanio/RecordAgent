# 复制为 .env 后设置本地专用数据库用户与随机密码；不要提交 .env。
RECORDAGENT_SERVER_PORT=9090
# 真机局域网联调时在本机 .env 设置为 0.0.0.0；默认仅监听本机。
RECORDAGENT_SERVER_ADDRESS=127.0.0.1
RECORDAGENT_DB_USER=
RECORDAGENT_DB_PASSWORD=
RECORDAGENT_DB_URL=jdbc:postgresql://localhost:5432/record
# 邮件未配置时验证码接口返回 503，健康检查仍可用于连接诊断。
RECORDAGENT_MAIL_FROM=
RECORDAGENT_MAIL_HOST=localhost
RECORDAGENT_MAIL_PORT=25
RECORDAGENT_MAIL_USER=
RECORDAGENT_MAIL_PASSWORD=
RECORDAGENT_MAIL_AUTH=false
RECORDAGENT_MAIL_STARTTLS=false
