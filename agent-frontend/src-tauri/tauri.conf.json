{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ButvanAgent",
  "version": "0.4.1",
  "identifier": "com.butvan.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node ../scripts/sync-version.mjs --check && bash ../agent-backend/scripts/package-sidecar.sh && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Butvan Agent",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$PICTURE/**",
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$PUBLIC/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/butvan-backend"
    ],
    "resources": {
      "binaries/butvan-backend.jar": "butvan-backend.jar",
      "binaries/butvan-backend-runtime/": "butvan-backend-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
